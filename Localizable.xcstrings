        "ru": { "stringUnit": { "state": "translated", "value": " через протокол Controller. Добавляйте, редактируйте и удаляйте для демонстрации CRUD." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "，使用 Controller 协议。添加、编辑和删除以查看实时 CRUD。" } }
